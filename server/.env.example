GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
SESSION_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# --- Image generation ----------------------------------------------------------
# No image env vars at all: IMAGE_PROVIDER_CHAIN=pollinations (keyless). As of
# Nov 2026 the keyless endpoint always serves its cheapest model ("sana"),
# whatever model is requested, so portraits look dated.
#
# Recommended: add a free secret key from https://enter.pollinations.ai/keys
# (must start with sk_; non-paid models draw on the free tier balance). With only the key set, the chain becomes
# pollinations_gen,pollinations automatically.
# POLLINATIONS_API_KEY=sk_xxx
# Optional model override. Seed-supporting models not marked paid_only include
# tongyi-mai/z-image-turbo (default) and black-forest-labs/flux.1.1-pro.
# Live list: https://gen.pollinations.ai/image/models
# POLLINATIONS_IMAGE_MODEL=tongyi-mai/z-image-turbo
#
# Or set the chain explicitly. Providers are tried left to right.
# Valid names: pollinations_gen, cloudflare_flux2, cloudflare, realvisxl,
# huggingface_flux, together, pollinations.
# IMAGE_PROVIDER_CHAIN=pollinations_gen,cloudflare_flux2,pollinations

# Required when realvisxl OR huggingface_flux is in the chain.
# HUGGINGFACE_API_TOKEN=hf_xxx

# Required when cloudflare or cloudflare_flux2 (FLUX.2 klein 9B) is in the chain.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Required when together is in the chain.
# TOGETHER_API_KEY=

# Storage backend for generated image bytes. 'disk' is the default and survives
# only within a single Node process (Render's free tier wipes disk on redeploy).
# Use 'r2' for durable Cloudflare R2 storage in production.
IMAGE_STORE=disk
IMAGE_CACHE_DIR=./data/image-cache
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=career-predictor-images
